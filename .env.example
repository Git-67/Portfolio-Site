# ── Twilio credentials ──────────────────────────────────────
# Get these from https://console.twilio.com after signing up
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Recipient ────────────────────────────────────────────────
# Your phone number that receives the SMS
OWNER_PHONE_NUMBER=+6590192209

# ── Server ───────────────────────────────────────────────────
PORT=3001

# ── CORS — comma-separated origins allowed to call the API ──
# Use 'null' to allow file:// (opening index.html directly)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,null
